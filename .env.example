# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - SGL-AIR
# ============================================================
# Este archivo (.env.example) SI se sube al repositorio: sirve
# de plantilla para que cada integrante sepa que variables
# necesita.
#
# El archivo real con los valores (.env) NO se sube NUNCA.
# Debe estar listado en .gitignore.
#
# Para usarlo:
#   1. Copie este archivo y renombrelo a  .env
#   2. Rellene los valores reales
#   3. Verifique que .env este en .gitignore
# ============================================================

# Servidor de Azure SQL (el host, no la base de datos)
DB_SERVER=sglairtec.database.windows.net

# Nombre de la base de datos
DB_NAME=sgl_air

# Usuario administrador de SQL
DB_USER=coloque_aqui_el_usuario

# Contrasena del usuario SQL
DB_PASSWORD=coloque_aqui_la_contrasena
